OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# Public test deployment. "local" preserves the desktop app; "anonymous"
# disables account connections and isolates profile data by browser cookie.
SMP_DEPLOYMENT_MODE=anonymous
SMP_SESSION_COOKIE_NAME=smp_session
SMP_SESSION_TTL_HOURS=24
SMP_SESSION_CLEANUP_INTERVAL_SECONDS=300
SMP_ANONYMOUS_MAX_UPLOAD_BYTES=104857600
SMP_ANONYMOUS_MAX_EVENTS=250000
SMP_ANONYMOUS_UPLOADS_PER_HOUR=4
SMP_ANONYMOUS_MAX_CONCURRENT_IMPORTS=2
SMP_SESSION_COOKIE_SECURE=true
# Use none for HTTPS frontend/API hosts on different sites; lax for same-site.
SMP_SESSION_COOKIE_SAMESITE=lax
# Use exact frontend origins when frontend and API are on separate hosts.
SMP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Preferred ytmusicapi OAuth setup. Keep real values in backend/private/.env or your shell, never in Git.
YTMUSIC_AUTH_FILE=backend/private/oauth.json
YTMUSIC_BROWSER_AUTH_FILE=backend/private/browser.json
YTMUSIC_OAUTH_CLIENT_ID=
YTMUSIC_OAUTH_CLIENT_SECRET=

# Optional Spotify login. Keep real values in backend/private/.env or your shell, never in Git.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8000/api/spotify/callback
